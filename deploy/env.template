# ICU Quality Dashboard runtime config
# Copy this file to .env and fill real values before running.

# Server
HOST=0.0.0.0
PORT=8091

# SmartCare database
# *_DB_NAME = actual MongoDB database name (preferred)
# *_DB_AUTH = authSource; also used as db name when *_DB_NAME is empty
SMARTCARE_DB_HOST=127.0.0.1
SMARTCARE_DB_PORT=27017
SMARTCARE_DB_USER=
SMARTCARE_DB_PASSWORD=
SMARTCARE_DB_NAME=
SMARTCARE_DB_AUTH=SmartCare

# DataCenter database
DATACENTER_DB_HOST=127.0.0.1
DATACENTER_DB_PORT=27017
DATACENTER_DB_USER=
DATACENTER_DB_PASSWORD=
DATACENTER_DB_NAME=
DATACENTER_DB_AUTH=DataCenter

# LLM, optional. AI fallback still works when these are empty, but AI quality is reduced.
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 完整地址 = LLM_BASE_URL + LLM_CHAT_PATH，例：http://192.168.x.x/llm/qwen + /chat/completions
LLM_CHAT_PATH=/chat/completions
# 思考模式（Qwen3 等混合思考模型，经 chat_template_kwargs.enable_thinking 下发）：on / off / default（不传参）
# 思考耗尽 max_tokens 时自动关闭思考重试；网关返回 400 时自动去掉该参数重试。
# 快速任务（质控报告总结、抗菌药物目的、脓毒症预警分诊）：输出短、调用量大，建议 off
LLM_THINKING=off
# 推理任务（脓毒性休克确认：Sepsis-3 综合判定 + T0 + SOFA 明细）：建议 on
LLM_THINKING_REASONING=on
# 推理任务思考开启时的 max_tokens 下限与超时
LLM_REASONING_MAX_TOKENS=4000
LLM_REASONING_TIMEOUT_S=120
# 可选：所有请求 max_tokens 的下限（0 = 用代码里各任务的默认值）
LLM_MAX_TOKENS=0
LLM_TIMEOUT_S=60
# 网关不支持 response_format=json_object 时设 false
LLM_JSON_MODE=true
# 内网自签证书：优先指定 CA 文件；LLM_TLS_INSECURE=true 仅限隔离测试
LLM_TLS_CA_FILE=
LLM_TLS_INSECURE=false

# ICU-05 hospital variant: default | cg
# cg only changes extraction rules + default db names (*_cg) when *_DB_NAME / *_DB_AUTH are empty.
BUNDLE_HOSPITAL_VARIANT=default

# VI_ICU_ZYYZ order statuses counted as "executed" (ICU-07 DVT numerator and
# culture-order matching share this). Comma-separated, multiple values allowed.
# Set to this hospital's own HIS status values, e.g.:
#   EXECUTED_ORDER_STATUSES="已校对,已停止,已确认停止"
EXECUTED_ORDER_STATUSES="已执行,已审核,停止,3"

# Lab-type yaoType values in VI_ICU_ZYYZ (ICU-06 culture-order query).
# Comma-separated; some hospitals use codes instead, e.g. "检验,C"
LAB_ORDER_TYPES="检验"
