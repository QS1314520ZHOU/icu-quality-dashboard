# ICU Quality Dashboard runtime config
# Copy this file to .env and fill real values before running.

# Server
HOST=0.0.0.0
PORT=8091

# SmartCare database
SMARTCARE_DB_HOST=127.0.0.1
SMARTCARE_DB_PORT=27017
SMARTCARE_DB_USER=
SMARTCARE_DB_PASSWORD=
SMARTCARE_DB_AUTH=SmartCare

# DataCenter database
DATACENTER_DB_HOST=127.0.0.1
DATACENTER_DB_PORT=27017
DATACENTER_DB_USER=
DATACENTER_DB_PASSWORD=
DATACENTER_DB_AUTH=DataCenter

# LLM, optional. AI fallback still works when these are empty, but AI quality is reduced.
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# ICU-05 hospital variant: default | cg (cg reads SmartCare_cg / DataCenter_cg)
BUNDLE_HOSPITAL_VARIANT=default

# VI_ICU_ZYYZ order statuses counted as "executed" (ICU-07 DVT numerator and
# culture-order matching share this). Comma-separated, multiple values allowed.
# Set to this hospital's own HIS status values, e.g.:
#   EXECUTED_ORDER_STATUSES="已校对,已停止,已确认停止"
EXECUTED_ORDER_STATUSES="已执行,已审核,停止,3"

# Lab-type yaoType values in VI_ICU_ZYYZ (ICU-06 culture-order query).
# Comma-separated; some hospitals use codes instead, e.g. "检验,C"
LAB_ORDER_TYPES="检验"
